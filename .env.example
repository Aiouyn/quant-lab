# ============================================================================
# Desk OS v3 — OpenCode $40 Plan + DeepSeek V4.1 Flash Configuration
# ============================================================================

# --- LLM Gateway & Model Routing (OpenCode + deepseek-v4.1-flash-free) ---
LLM_PROVIDER=opencode
OPENCODE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/v1
MIMO_BASE_URL=https://opencode.ai/zen/v1
MODEL_NAME=deepseek-v4.1-flash-free
DESK_FLASH_MODEL=deepseek-v4.1-flash-free
DESK_FLASH_ROLES=cio,lead,researcher,officer,pm,execution,librarian,toolsmith

# --- Concurrency & Token-Plan Pacing ($40 OpenCode Plan) ---
DESK_START_CONCURRENCY=8
DESK_MAX_CONCURRENCY=24
KPI_USD_PER_CREDIT=0.00000000145

# --- Storage, Ledger & Data Paths ---
RESULTS_DIR=results/v3
DATABASE_PATH=results/v3/desk.sqlite3
OKX_DATA_DIR=data/okx_l2_btc

# --- Sandbox & Harness Compute Limits ---
DESK_SANDBOXES=2
DESK_JOB_SLOTS=1
DESK_SANDBOX_MB=4000
DESK_JOB_MB=5000

# --- Control Room Web Server ---
HOST=0.0.0.0
DESK_PORT=3000

# --- Legacy / Optional Fallbacks ---
