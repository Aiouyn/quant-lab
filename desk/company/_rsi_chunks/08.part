    ],
    'execution_stabilizers': [
        {
            'id': 'adaptive_deadband_hysteresis',
            'label': 'Volatility-Scaled Rebalance Deadband Hysteresis',
            'formula': 'S(w_t, w_{t-1}) = w_{t-1} if |w_t - w_{t-1}| < δ·σ_t else w_t',
