vents': 1.4, 'carry': 1.8, 'regime': 1.3, 'meta': 1.5, 'positioning': 1.1, 'pred': 0.8}.get(p, 1.0)
            L.x('INSERT OR IGNORE INTO pods VALUES(?,?,?,?)', (p, mandate, w, time.time()))
    else:
