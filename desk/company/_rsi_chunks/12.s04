ft_z = None
            verdict = 'NOT_RUN'
        forward_survival.append({
            'id': fr['id'],
            'name': fr['name'],
            'desk': fr.get('pod') or 'macro',
            'status': fr['status'],
            'val_sharpe': round(vsr, 2) if vsr is not None else None,
            'holdout_sharpe': round(hsr, 2) if hsr is not None else None,
            'forward_sharpe': round(fsr, 2) if fsr is not None else None,
            'forward_max_dd': round(f_dd, 4) if f_dd is not None else None,
            'drift_z': round(drift_z, 2) if drift_z is not None else None,
            'verdict': verdict,
        })

    treasury = compute_treasury_state(ledger, settings=settings)
    latest_funnel = next((r['metrics'] for r in runs if r['kind'] == 'tournament_funnel' and isinstance(r.get('metrics'), dict)), None)

    approved_count = ledger.q("SELECT COUNT(*) AS n FROM strategies WHERE status IN ('approved', 'paper')")[0]['n']
    total_hits = sum(h['hits'] for h in hints_rows)
    total_res = sum(h['resolved_count'] for h in hints_rows)
    prims_obs = [p for p in prims if int(p.get('total_uses') or 0) > 0]
    mean_lift = round(float(np.mean([p['composite_lift'] for p in prims_obs])), 3) if prims_obs else None
    mean_delta_sr = round(float(np.mean([l['delta_score'] for l in lineages])), 2) if lineages else None
    latest_drill = next((r['metrics'] for r in runs if r['kind'] == 'drill_benchmark' and isinstance(r.get('metrics'), dict)), None)
    latest_scoreboard = campaign_gens[-1] if campaign_gens else compute_generation_scoreboard(ledger)
    daemon_st = rs